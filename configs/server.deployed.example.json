    },
    "arx_direct_teaching": {
      "profile_path": "configs/arx-x5-direct-teaching-v1-effective-static-v7.json",
      "provider": "arx_direct_teaching",
      "raw_formats": ["arx_direct_teaching_hdf5_v1"],
      "accepted_capture_profile_hashes": []
    },
    "arx_hdf5": {
      "profile_path": "configs/arx-x5-hdf5-mem-v1.json",
      "provider": "aloha_hdf5",
      "raw_formats": ["aloha_hdf5_episodes_v1"],
      "accepted_capture_profile_hashes": []
    },
    "arx_kinesthetic": {
      "profile_path": "configs/arx-x5-kinesthetic-v1.json",
      "provider": "arx_kinesthetic",
      "raw_formats": ["arx_kinesthetic_hdf5_v1"],
      "accepted_capture_profile_hashes": []
