  "argus_base_url": "",
  "argus_api_key_env": "PIPELINE_ARGUS_API_KEY",
  "argus_auto_label": false,
  "argus_annotation_unlimited": false,
  "argus_max_tokens": 12000,
  "argus_per_episode_budget_usd": 1.0
