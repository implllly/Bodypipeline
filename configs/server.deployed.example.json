{
  "root": ".runtime/server",
  "data_root": ".runtime/server-data",
  "import_roots": [".runtime/imports"],
  "processing_mode": "real",
  "auto_process": false,
  "trusted_network": false,
  "min_free_bytes": 10737418240,
  "server_url": "http://127.0.0.1:8081",
  "viewer_origin": "http://127.0.0.1:8082",
  "viewer_ui_port": 13100,
  "viewer_data_port": 18765,
  "letools_bin": "letools",
  "tianji_provider_bin": "tianji-provider",
  "viewer_bun": "",
  "profiles": {
    "agilex_aloha_agx": {
