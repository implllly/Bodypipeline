+/**
+ * Load all episode lengths from ``meta/episodes.jsonl`` (v2.1).
+ * Returns min/max/mean/median/std and a histogram, or null if unavailable.
+ */
+export async function loadAllEpisodeLengthsV21(
+  repoId: string,
+  version: string,
+  fps: number,
+): Promise<EpisodeLengthStats | null> {
+  try {
+    const url = buildVersionedUrl(repoId, version, "meta/episodes.jsonl");
+    const response = await fetch(url, { cache: "no-store" });
+    if (!response.ok) return null;
+    const allEpisodes: { index: number; length: number }[] = [];
+    for (const line of (await response.text()).split("\n")) {
+      if (!line.trim()) continue;
+      const row = JSON.parse(line) as {
+        episode_index?: unknown;
+        length?: unknown;
+      };
+      const index = Number(row.episode_index);
+      const length = Number(row.length);
+      // Datasets without per-episode lengths stay unavailable rather than
+      // showing a misleading histogram.
+      if (!Number.isFinite(index) || !Number.isFinite(length) || length <= 0) {
+        continue;
+      }
+      allEpisodes.push({ index, length });
+    }
+    return summarizeEpisodeLengths(allEpisodes, fps);
   } catch {
     return null;
   }
 }
 
+/**
+ * Load episode length statistics for every dataset version the viewer parses.
+ * Unsupported versions stay null so the statistics and duration filter hide.
+ */
+export async function loadAllEpisodeLengths(
+  repoId: string,
+  version: string,
+  fps: number,
+): Promise<EpisodeLengthStats | null> {
+  if (version === "v3.0") return loadAllEpisodeLengthsV3(repoId, version, fps);
+  if (version === "v2.1") return loadAllEpisodeLengthsV21(repoId, version, fps);
+  return null;
+}
